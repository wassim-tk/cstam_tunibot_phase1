<?xml version="1.0"?>
<robot name="cstam_waiter_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials for RViz & Classic Fallback -->
  <material name="chassis_white">
    <color rgba="0.92 0.94 0.96 1.0"/>
  </material>
  <material name="metallic_dark">
    <color rgba="0.15 0.17 0.20 1.0"/>
  </material>
  <material name="accent_cyan">
    <color rgba="0.0 0.75 0.85 1.0"/>
  </material>
  <material name="tray_mat">
    <color rgba="0.22 0.25 0.28 1.0"/>
  </material>
  <material name="screen_glass">
    <color rgba="0.05 0.08 0.12 1.0"/>
  </material>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- Base Chassis Link -->
  <link name="base_link">
    <!-- Main Lower Chassis -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.26" length="0.16"/>
      </geometry>
      <material name="chassis_white"/>
    </visual>
    <!-- Bumper Ring -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.265" length="0.04"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.26" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.32" ixy="0.0" ixz="0.0" iyy="0.32" iyz="0.0" izz="0.55"/>
    </inertial>
  </link>

  <!-- Left Drive Wheel -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.22 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Drive Wheel -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.22 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Caster -->
  <link name="caster_front">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.18 0 -0.045" rpy="0 0 0"/>
  </joint>

  <!-- Rear Caster -->
  <link name="caster_rear">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.18 0 -0.045" rpy="0 0 0"/>
  </joint>

  <!-- Low-Mounted 360 LiDAR Sensor Link -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.16 0 0.13" rpy="0 0 0"/>
  </joint>

  <!-- Vertical Structural Spine Columns (Dual Back Pillars) -->
  <link name="vertical_spine">
    <!-- Left Upright Pillar -->
    <visual>
      <origin xyz="-0.12 0.14 0.50" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.90"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="-0.12 0.14 0.50" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.90"/></geometry>
    </collision>
    <!-- Right Upright Pillar -->
    <visual>
      <origin xyz="-0.12 -0.14 0.50" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.90"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="-0.12 -0.14 0.50" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.90"/></geometry>
    </collision>
    <!-- Rear Spine Fairing / Shell -->
    <visual>
      <origin xyz="-0.14 0 0.50" rpy="0 0 0"/>
      <geometry><box size="0.04 0.32 0.90"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="-0.14 0 0.50" rpy="0 0 0"/>
      <geometry><box size="0.04 0.32 0.90"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.12 0 0.50" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.25" ixy="0" ixz="0" iyy="0.25" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="vertical_spine_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vertical_spine"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
  </joint>

  <!-- Shelf Tier 1 (Lower Food Shelf) -->
  <link name="shelf_lower">
    <!-- Tray Board -->
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.025"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <!-- Non-slip Surface Mat -->
    <visual>
      <origin xyz="0.04 0 0.014" rpy="0 0 0"/>
      <geometry><box size="0.35 0.35 0.004"/></geometry>
      <material name="tray_mat"/>
    </visual>
    <!-- Front Retaining Rim -->
    <visual>
      <origin xyz="0.225 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.015 0.38 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <!-- Left Retaining Rim -->
    <visual>
      <origin xyz="0.04 0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <!-- Right Retaining Rim -->
    <visual>
      <origin xyz="0.04 -0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.025"/>
    </inertial>
  </link>

  <joint name="shelf_lower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_lower"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- Shelf Tier 2 (Middle Food Shelf) -->
  <link name="shelf_middle">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.025"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <visual>
      <origin xyz="0.04 0 0.014" rpy="0 0 0"/>
      <geometry><box size="0.35 0.35 0.004"/></geometry>
      <material name="tray_mat"/>
    </visual>
    <visual>
      <origin xyz="0.225 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.015 0.38 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <visual>
      <origin xyz="0.04 0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <visual>
      <origin xyz="0.04 -0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.025"/>
    </inertial>
  </link>

  <joint name="shelf_middle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_middle"/>
    <origin xyz="0 0 0.58" rpy="0 0 0"/>
  </joint>

  <!-- Shelf Tier 3 (Upper Food Shelf) -->
  <link name="shelf_upper">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.025"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <visual>
      <origin xyz="0.04 0 0.014" rpy="0 0 0"/>
      <geometry><box size="0.35 0.35 0.004"/></geometry>
      <material name="tray_mat"/>
    </visual>
    <visual>
      <origin xyz="0.225 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.015 0.38 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <visual>
      <origin xyz="0.04 0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <visual>
      <origin xyz="0.04 -0.185 0.015" rpy="0 0 0"/>
      <geometry><box size="0.38 0.015 0.03"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.38 0.38 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.025"/>
    </inertial>
  </link>

  <joint name="shelf_upper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_upper"/>
    <origin xyz="0 0 0.85" rpy="0 0 0"/>
  </joint>

  <!-- Top Interactive Head Console & Screen Unit -->
  <link name="head_console">
    <!-- Top Canopy Head Shell -->
    <visual>
      <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.28 0.34 0.10"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <!-- Customer Interactive Touchscreen Display (Angled 35 deg) -->
    <visual>
      <origin xyz="0.06 0 0.06" rpy="0 0.61 0"/>
      <geometry><box size="0.18 0.24 0.015"/></geometry>
      <material name="screen_glass"/>
    </visual>
    <!-- Waiter Eye / Status Light Bar -->
    <visual>
      <origin xyz="0.12 0 0.07" rpy="0 0.61 0"/>
      <geometry><box size="0.01 0.18 0.02"/></geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.28 0.34 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <joint name="head_console_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head_console"/>
    <origin xyz="0 0 1.05" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Sim Differential Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <max_linear_acceleration>1.2</max_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Gazebo Sim LiDAR Sensor Plugin -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <gz_frame_id>laser_frame</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Material appearances in Gazebo Sim -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.92 0.94 0.96 1.0</ambient>
        <diffuse>0.92 0.94 0.96 1.0</diffuse>
        <specular>0.4 0.4 0.4 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="shelf_lower">
    <visual>
      <material>
        <ambient>0.25 0.28 0.32 1.0</ambient>
        <diffuse>0.25 0.28 0.32 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="shelf_middle">
    <visual>
      <material>
        <ambient>0.25 0.28 0.32 1.0</ambient>
        <diffuse>0.25 0.28 0.32 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="shelf_upper">
    <visual>
      <material>
        <ambient>0.25 0.28 0.32 1.0</ambient>
        <diffuse>0.25 0.28 0.32 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="head_console">
    <visual>
      <material>
        <ambient>0.92 0.94 0.96 1.0</ambient>
        <diffuse>0.92 0.94 0.96 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

</robot>
