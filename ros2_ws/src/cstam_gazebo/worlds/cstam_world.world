<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="cstam_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Perimeter Walls (10m x 10m area) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior Partition Walls creating Narrow Passage / Doorway -->
    <model name="partition_wall_left">
      <static>true</static>
      <pose>-1.5 1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="partition_wall_right">
      <static>true</static>
      <pose>2.5 1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Furniture / Landmarks -->
    <!-- Docking Station (Origin: x=-4.0, y=-4.0) -->
    <model name="docking_station">
      <static>true</static>
      <pose>-4.0 -4.0 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.1 0.7 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Kitchen / Pickup Station (x=-3.5, y=3.5) -->
    <model name="kitchen_pickup">
      <static>true</static>
      <pose>-3.5 3.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 1.5 0.8</size></box></geometry>
          <material>
            <ambient>0.1 0.4 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>1.2 1.5 0.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Table 1 (x=3.0, y=3.5) -->
    <model name="table_1">
      <static>true</static>
      <pose>3.0 3.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Table 2 (x=3.5, y=-2.5) -->
    <model name="table_2">
      <static>true</static>
      <pose>3.5 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1.0</ambient>
            <diffuse>0.9 0.8 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Dynamic Obstacle Model (Moving Obstacle crossing central corridor) -->
    <model name="dynamic_obstacle">
      <pose>0 -1 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.4 0.1 1.0</ambient>
            <diffuse>0.9 0.4 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
