<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="cstam_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Warm Ambient Restaurant Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Restaurant Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.80 0.76 1</ambient>
            <diffuse>0.82 0.80 0.76 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Perimeter Walls (10m x 10m area) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.40 0.45 1</ambient><diffuse>0.35 0.40 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.40 0.45 1</ambient><diffuse>0.35 0.40 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.40 0.45 1</ambient><diffuse>0.35 0.40 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material><ambient>0.35 0.40 0.45 1</ambient><diffuse>0.35 0.40 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior Partition Walls creating Central Doorway Passage (Gap between x=0.0 and x=1.0 at y=1.0) -->
    <model name="partition_wall_left">
      <static>true</static>
      <pose>-1.5 1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.62 0.42 0.26 1</ambient><diffuse>0.62 0.42 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_wall_right">
      <static>true</static>
      <pose>2.5 1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.62 0.42 0.26 1</ambient><diffuse>0.62 0.42 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Docking Station (x=-4.0, y=-4.0) -->
    <model name="docking_station">
      <static>true</static>
      <pose>-4.0 -4.0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="base_pad">
          <geometry><box><size>0.8 0.8 0.1</size></box></geometry>
          <material><ambient>0.15 0.65 0.35 1</ambient><diffuse>0.15 0.65 0.35 1</diffuse></material>
        </visual>
        <visual name="charge_tower">
          <pose>-0.35 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 0.4 0.4</size></box></geometry>
          <material><ambient>0.2 0.25 0.3 1</ambient><diffuse>0.2 0.25 0.3 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.2</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Kitchen / Pickup Station (x=-3.5, y=3.5) -->
    <model name="kitchen_pickup">
      <static>true</static>
      <pose>-3.5 3.5 0.45 0 0 0</pose>
      <link name="link">
        <!-- Main Counter -->
        <visual name="counter">
          <geometry><box><size>1.2 1.8 0.9</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.2 0.4 0.7 1</diffuse></material>
        </visual>
        <!-- Counter Top Surface -->
        <visual name="counter_top">
          <pose>0 0 0.46 0 0 0</pose>
          <geometry><box><size>1.3 1.9 0.04</size></box></geometry>
          <material><ambient>0.9 0.92 0.95 1</ambient><diffuse>0.9 0.92 0.95 1</diffuse></material>
        </visual>
        <!-- Food Trays on Counter -->
        <visual name="food_tray_1">
          <pose>-0.2 0.4 0.49 0 0 0</pose>
          <geometry><box><size>0.3 0.4 0.02</size></box></geometry>
          <material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material>
        </visual>
        <visual name="food_tray_2">
          <pose>-0.2 -0.4 0.49 0 0 0</pose>
          <geometry><box><size>0.3 0.4 0.02</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>1.3 1.9 0.94</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Dining Table 1 (x=3.0, y=3.5) -->
    <model name="table_1">
      <static>true</static>
      <pose>3.0 3.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="tabletop">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.75 0.25 0.25 1</ambient><diffuse>0.75 0.25 0.25 1</diffuse></material>
        </visual>
        <!-- Plate on Table 1 -->
        <visual name="plate">
          <pose>0 0 0.41 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Chairs for Table 1 -->
    <model name="table_1_chair_a">
      <static>true</static>
      <pose>2.1 3.5 0.25 0 0 0</pose>
      <link name="link">
        <visual name="seat"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
      </link>
    </model>
    <model name="table_1_chair_b">
      <static>true</static>
      <pose>3.9 3.5 0.25 0 0 0</pose>
      <link name="link">
        <visual name="seat"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Dining Table 2 (x=3.5, y=-2.5) -->
    <model name="table_2">
      <static>true</static>
      <pose>3.5 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="tabletop">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.85 0.72 0.2 1</ambient><diffuse>0.85 0.72 0.2 1</diffuse></material>
        </visual>
        <visual name="water_glass">
          <pose>0.1 0.1 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.4 0.7 0.9 0.8</ambient><diffuse>0.4 0.7 0.9 0.8</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Dining Table 3 (x=1.0, y=-3.5) -->
    <model name="table_3">
      <static>true</static>
      <pose>1.0 -3.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="tabletop">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.75 1</ambient><diffuse>0.55 0.35 0.75 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Dynamic Obstacle Model (Pedestrian crossing central corridor) -->
    <model name="dynamic_obstacle">
      <pose>0 -1 0.8 0 0 0</pose>
      <link name="link">
        <!-- Body Torso -->
        <visual name="torso">
          <geometry><cylinder><radius>0.22</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.95 0.45 0.15 1</ambient><diffuse>0.95 0.45 0.15 1</diffuse></material>
        </visual>
        <!-- Head -->
        <visual name="head">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material><ambient>0.85 0.65 0.5 1</ambient><diffuse>0.85 0.65 0.5 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.26</radius><length>1.6</length></cylinder></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
